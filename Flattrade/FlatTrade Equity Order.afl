Easy Simple Trading Solutions
Telegram @easysimpletradeupdates
Website https://easysimpletrade.blogspot.com
Youtube https://www.youtube.com/@easysimpletrade
GitHub https://github.com/EasySimpleTrade
*/

RequestTimedRefresh(1,False);

//Strategy Code Start---------------------------------
Buy = Sell = Short = Cover = 0;
//Strategy Code End -----------------------------------------

//Defaults
ND = Day() != Ref(Day(),-1);
ED = Day()!= Ref(Day(), 1);
TN = TimeNum();
BI = BarIndex();
CZ = LastValue(C);
TZ = LastValue(TN);
BZ = LastValue(BI);

//Chart Code Start ----------------------------
_N(Title = StrFormat("{{NAME}} - {{INTERVAL}} {{DATE}} O %g, H %g, L %g, C %g  {{VALUES}}", O, H, L, C  ));
SetChartOptions(0,chartShowArrows|chartShowDates);
SetBarFillColor( IIf( C > O, ColorRGB( 0, 75, 0 ), IIf( C <= O, ColorRGB( 75, 0, 0 ), colorLightGrey ) ) );
Plot( C, "", IIf( C > O, ColorRGB( 0, 255, 0 ), IIf( C <= O, ColorRGB( 255, 0, 0 ), colorLightGrey ) ), 64, Null, Null, 0, 0, 1 );

//Indicators
TimeFrameSet(inDaily);
PDH =  Ref(H,-1); PDL =  Ref(L,-1); PDC =  Ref(C,-1);
TimeFrameRestore();

PDH =  TimeFrameExpand(PDH, inDaily,expandFirst);    
PDL =  TimeFrameExpand(PDL, inDaily,expandFirst);
PDC =  TimeFrameExpand(PDC, inDaily,expandFirst);

PWH =  TimeFrameGetPrice("H", inWeekly, -1);    
PWL =  TimeFrameGetPrice("L", inWeekly, -1);

//Pivot Points
DPP=(PDH+PDL+PDC)/3;
DR1=(2*DPP)-PDL;
DR2=DPP+(PDH-PDL);
DR3=PDH+2*(DPP-PDL);
DS1=(2*DPP)-PDH;
DS2=DPP-(PDH-PDL);
DS3=PDL-2*(PDH-DPP);
//CPR
DLB = (PDH+PDL) / 2;
DUB = (2*DPP) - DLB;
//CPR TOP and Bottom
TCPR = Prec(Max(DLB,DUB),1);
BCPR = Prec(Min(DLB,DUB),1);

//Previous Day PP, CPR Top Bottom
PDPP   = ValueWhen(ND,Ref(DPP,-1));
PTCPR = ValueWhen(ND,Ref(TCPR,-1));
PBCPR = ValueWhen(ND,Ref(BCPR,-1));
//Narrow CPR
CPR = (abs(DUB-DLB) / C)*100;
NCPR = (CPR < 0.05);
//Higher High CPR
HHCPR = BCPR > PTCPR;
//Lower Low CPR
LLCPR = TCPR < PBCPR;
//Inside CPR
ICPR = PTCPR > TCPR AND PBCPR < BCPR;
//Outside CPR
OCPR = PTCPR < TCPR AND PBCPR > BCPR;

//VWAP 
if (Name() == "NIFTY" ) V = Foreign("NIFTY-I","V");
Bars = BarsSince(ED);
NDV = Sum(V,Bars);
VWAP = Sum (Avg * V, Bars)/NDV;


INTRADAY = Interval() <= 1800;

if(INTRADAY)
{
Plot (IIf(ED,Null,VWAP),"VWAP",colorCustom11,styleNoLabel);

Plot( IIf(ED,Null,PDH),"", colorRed, styleNoLabel|styleNoRescale|styleDashed);
Plot( IIf(ED,Null,PDL),"", colorLime, styleNoLabel|styleNoRescale|styleDashed);

PlotText("PDH",LastValue(BarIndex()+1),LastValue(PDH),colorRed,colorDefault,-5);
PlotText("PDL",LastValue(BarIndex()+1),LastValue(PDL),colorLime,colorDefault,-5);

Plot( IIf(ED,Null,PWH),"", colorRed, styleNoLabel|styleNoRescale|styleDots);
Plot( IIf(ED,Null,PWL),"", colorLime, styleNoLabel|styleNoRescale|styleDots);

PlotText("PWH",LastValue(BarIndex()+1),LastValue(PWH),colorRed,colorDefault,-5);
PlotText("PWL",LastValue(BarIndex()+1),LastValue(PWL),colorLime,colorDefault,-5);

Plot( IIf(ED,Null,DR3),"", colorRed, styleNoLabel|styleNoRescale);
Plot( IIf(ED,Null,DR2),"", colorRed, styleNoLabel|styleNoRescale);
Plot( IIf(ED,Null,DR1),"", colorRed, styleNoLabel|styleNoRescale);
Plot( IIf(ED,Null,DPP),"", colorAqua, styleNoLabel|styleNoRescale);
Plot( IIf(ED,Null,DS1),"", colorLime, styleNoLabel|styleNoRescale);
Plot( IIf(ED,Null,DS2),"", colorLime, styleNoLabel|styleNoRescale);
Plot( IIf(ED,Null,DS3),"", colorLime, styleNoLabel|styleNoRescale);

PlotText("DR3",LastValue(BarIndex()+1),LastValue(DR3),colorRed,colorDefault,-5);
PlotText("DR2",LastValue(BarIndex()+1),LastValue(DR2),colorRed,colorDefault,-5);
PlotText("DR1",LastValue(BarIndex()+1),LastValue(DR1),colorRed,colorDefault,-5);
PlotText("DS1",LastValue(BarIndex()+1),LastValue(DS1),colorLime,colorDefault,-5);
PlotText("DS2",LastValue(BarIndex()+1),LastValue(DS2),colorLime,colorDefault,-5);
PlotText("DS3",LastValue(BarIndex()+1),LastValue(DS3),colorLime,colorDefault,-5);


//Cloud
NDTCPR = IIf(ED,Null,TCPR);
NDBCPR = IIf(ED,Null,BCPR);
ColorCPR = IIf(NCPR OR ICPR OR OCPR,ColorRGB(196,196,128),IIf(HHCPR,ColorRGB(0,48,0),IIf(LLCPR,ColorRGB(48,0,0),ColorRGB(0,0,48))));
PlotOHLC( NDTCPR, NDTCPR, NDBCPR, NDBCPR, "", ColorCPR, styleNoLabel | styleCloud | styleNoRescale, Null, Null,0,-1);
}

//Volume
PaneHght = 15;//Param( "Volume Pane Height (in %)", 15, 1, 100, 1 );
PaneHghtMin = LowestVisibleValue( V);
PaneHghtMax = HighestVisibleValue(V) * 100 / PaneHght;
gxs= 15;//Param("GRAPH spaceing",15,5,50,5); 
GraphXSpace = gxs;
ColorVolume = IIf( C > O, ColorRGB( 0, 255, 0 ), IIf( C <= O, ColorRGB( 255, 0, 0 ), colorLightGrey ) );
MAV=MA(Volume,50);
Plot( MAV, "MAV50", colorblue, styleOwnScale | styleNoLabel   ,  PaneHghtMin, PaneHghtMax, 0, 0, 2 );
Plot( V, "V", ColorVolume ,  styleHistogram | styleOwnScale | styleThick | styleNoLabel , PaneHghtMin, PaneHghtMax, 0, 0, 2 );

//Chart Code End ---------------------------------------


//Parameters
_SECTION_BEGIN("FlatTrade Equity Order");
TDVAL = Param("Position Size", 100000,1,1000000,1);
LMTOFS = Param("Limit Order Offset in %", 1,0.0,10,0.1)/100;
EnAlgo = ParamToggle("Enable Algo","No|Yes",1);
EnOrdNo = ParamToggle("Need Order No","No|Yes",1);
OUTPATH = ParamStr("Path to Save Response","R:\\");
EQSUF = ParamStr("NSE Equity Symbol Suffix", "-EQ");
STGTAG = ParamStr("Strategy Tag","EQUITY");

HX = Param("Button Horizontal Position",0,0,164);
HY = Param("Button Vertical Position",0,0,89);
_SECTION_END();

//Prefix for Static Variable
SName = STGTAG+"FLA"+Name()+Interval();

//Button Code Start----------------------------------------------------
PX = 10;//round(Status("pxwidth")/164);
PY = 10;//round(Status("pxheight")/89);

Reset = 0;
BuyBut = 2;
SellBut = 3;
ShortBut = 4;
CoverBut = 5;
ResetBut =6;

GuiButton( "Buy", BuyBut,  PX*1+PX*HX, PY*2+PY*HY, PY*6, PY*3, notifyClicked );
GuiButton( "Sell", SellBut,  PX*8+PX*HX, PY*2+PY*HY, PY*6, PY*3, notifyClicked );

GuiButton( "Short",ShortBut,  PX*1+PX*HX, PY*6+PY*HY, PY*6, PY*3, notifyClicked );
GuiButton( "Cover", CoverBut,  PX*8+PX*HX, PY*6+PY*HY, PY*6, PY*3, notifyClicked );

GuiButton( "Reset", ResetBut, PX*15+PX*HX, PY*2+PY*HY, PY*6, PY*3, notifyClicked );

GuiSetColors( 2, 3, 2, colorBlack, colorLime,colorGreen,-1,colorGreen);
GuiSetColors( 4, 5, 2, colorYellow, colorOrange,colorRed,-1,colorRed);
GuiSetColors( 6, 6, 2, colorBlack, colorYellow, colorGold,-1,colorGold );

function HandleEvents() 
{ 
    for ( n = 0;id = GuiGetEvent( n, 0 );n++ )
    { 
        code = GuiGetEvent( n, 1 ); 

         switch ( id ) 
        { 
             case BuyBut:                                   
             Buy = 1;             
             break; 
             
             case SellBut: 
             Sell = 1;
             break;              

             case ShortBut:
             Short = 1;
             break; 

             case CoverBut: 
             Cover = 1;
             break; 
             
             case ResetBut: 
             Reset = 1;
             break;                                      
        } 
    } 
} 
HandleEvents();

//Button Code End--------------------------------------

//Order Place Code Start----------------------------------

BASEURL = "https://piconnect.flattrade.in/PiConnectAPI/PlaceOrder";

function FlatTradeOrder(TRANTYPE,TSYM,QTY,PRC,TRGPRC,ORDTYP,PRD,EXCH,UID,TOKEN,REMARKS,OUT)
{
ShellExecute("Curl.exe",""+BASEURL+" -d \"jData={\\\"ordersource\\\": \\\"API\\\", \\\"uid\\\": \\\""+UID+"\\\", \\\"actid\\\": \\\""+UID+"\\\", \\\"trantype\\\": \\\""+TRANTYPE+"\\\", \\\"prd\\\": \\\""+PRD+"\\\", \\\"exch\\\": \\\""+EXCH+"\\\", \\\"tsym\\\": \\\""+TSYM+"\\\", \\\"qty\\\": \\\""+QTY+"\\\", \\\"dscqty\\\": \\\"0\\\", \\\"prctyp\\\": \\\""+ORDTYP+"\\\", \\\"prc\\\": \\\""+PRC+"\\\", \\\"trgprc\\\": \\\""+TRGPRC+"\\\", \\\"ret\\\": \\\"DAY\\\", \\\"remarks\\\": \\\""+REMARKS+"\\\", \\\"amo\\\": \\\"NO\\\"}\" -d \"jKey="+TOKEN+"\" "+OUT+"","",0);
return ;
}

/*
//Telegram Alert Function
function Telegram(Key,ID,Message)
{
ih = InternetOpenURL("https://api.telegram.org/bot"+Key+"/sendMessage?chat_id="+ID+"&text="+Message); 
if(ih) InternetClose( ih );
return ;
}

//Telegram
BOTKEY = ParamStr("Telegram Bot Key","");
CHANNELID = ParamStr("Channel ID","");

*/

//API Credentials
FLAUID1 = StaticVarGetText("FLAUSERID"+"1");//"1" - User Number
FLATOK1 = StaticVarGetText("FLATOKEN"+"1");//"1" - User Number
FLASESSIONOK1 = FLAUID1 != "" AND FLATOK1 != "" ;

FLAOUTRESP1 = WriteIf(EnOrdNo,"-o "+OUTPATH+"\\"+Name()+" FLA"+"1"+".txt","");//"1" - User Number

//Name
EQNAME = StrReplace(Name(),"&","%26")+EQSUF;

//Quantity
NDO = TimeFrameGetPrice("O",inDaily);
QTY = LastValue(round(TDVAL/NDO));

//Market Order as Limit Order
BUYOFS = round(C * (1+LMTOFS));
SELOFS = round(C * (1-LMTOFS));

//Messages
BuyMessage = Name()+" Buy "+C;
SellMessage = Name()+" Sell "+C;
ShortMessage = Name()+" Short "+C;
CoverMessage = Name()+" Cover "+C;

EXCHANGE = "NSE" ;//NSE NFO CDS MCX BSE
PRODUCT = "I"; //Product C-CNC M-NRML  H-CO  B-BO I-MIS  F-MTF
ORDERTYPE = "LMT";//LMT/MKT/SL-LMT/SL-MKT
//Order Place Function Parameters: Buy/Sell B/S Symbol, Quantity, Price,Trigger Price, PriceType LMT/MKT/SL-LMT/SL-MKT, Product C-CNC M-NRML  H-CO  B-BO I-MIS  F-MTF, Exchange NSE / NFO / CDS / MCX / BSE / BFO, User ID, Access Token,Respone enable and path

//Buy-------------------------------------------------------------------------------------------------
if (LastValue(Buy) AND Nz(StaticVarGet(SName+"INUPTRADE")) == 0  AND Nz(StaticVarGet(SName+"INDNTRADE")) == 0 AND Nz(StaticVarGet(SName+"UPExitTime")) != TZ)
{
if(EnAlgo AND FLASESSIONOK1) FlatTradeOrder("B",EQNAME,QTY,BUYOFS,"None",ORDERTYPE,PRODUCT,EXCHANGE,FLAUID1,FLATOK1,STGTAG,FLAOUTRESP1);

StaticVarSet(SName+"INUPTRADE",1);
StaticVarSet(SName+"UPENTRY",CZ);

_TRACE(BuyMessage);
//PopupWindow(BuyMessage, Name(),5,800,50);
//Telegram(BOTKEY,CHANNELID,BuyMessage); 
}

UPENTRY = StaticVarGet(SName+"UPENTRY");
UPPNL = round((CZ - UPENTRY)*QTY);

MTM = Nz(StaticVarGet(SName+"MTM"));
//Sell-----------------------------------------------------------------------------------------------------
if (LastValue(Sell) AND StaticVarGet(SName+"INUPTRADE"))
{
if(EnAlgo AND FLASESSIONOK1) FlatTradeOrder("S",EQNAME,QTY,SELOFS,"None",ORDERTYPE,PRODUCT,EXCHANGE,FLAUID1,FLATOK1,STGTAG,FLAOUTRESP1);

StaticVarSet(SName+"INUPTRADE",0);
StaticVarSet(SName+"UNENTRY",0);
StaticVarSet(SName+"UPExitTime",TZ);
StaticVarSet(SName+"MTM", MTM+UPPNL);

_TRACE(SellMessage);
_TRACE("PNL "+UPPNL);
_TRACE("MTM "+StaticVarGet(SName+"MTM"));
//PopupWindow(SellMessage, Name(),5,800,50);
//Telegram(BOTKEY,CHANNELID,SellMessage); 
}

//Short-----------------------------------------------------------------------------------------------------
if (LastValue(Short) AND Nz(StaticVarGet(SName+"INUPTRADE")) == 0  AND Nz(StaticVarGet(SName+"INDNTRADE")) == 0  AND Nz(StaticVarGet(SName+"DNExitTime")) != TZ)
{
if(EnAlgo AND FLASESSIONOK1) FlatTradeOrder("S",EQNAME,QTY,SELOFS,"None",ORDERTYPE,PRODUCT,EXCHANGE,FLAUID1,FLATOK1,STGTAG,FLAOUTRESP1);

StaticVarSet(SName+"INDNTRADE",1);
StaticVarSet(SName+"DNENTRY",CZ);

_TRACE(ShortMessage);
//PopupWindow(ShortMessage, Name(),10,300,50);
//Telegram(BOTKEY,CHANNELID,ShortMessage); 
}

DNENTRY = StaticVarGet(SName+"DNENTRY");
DNPNL = round((DNENTRY - CZ)*QTY);

//Cover-----------------------------------------------------------------------------------------------------
if (LastValue(Cover)  AND StaticVarGet(SName+"INDNTRADE"))
{
if(EnAlgo AND FLASESSIONOK1) FlatTradeOrder("B",EQNAME,QTY,BUYOFS,"None",ORDERTYPE,PRODUCT,EXCHANGE,FLAUID1,FLATOK1,STGTAG,FLAOUTRESP1);

StaticVarSet(SName+"INDNTRADE",0);
StaticVarSet(SName+"DNENTRY",0);
StaticVarSet(SName+"DNExitTime",TZ);
StaticVarSet(SName+"MTM", MTM+DNPNL);

_TRACE(CoverMessage);
_TRACE("PNL "+DNPNL);
_TRACE("MTM "+StaticVarGet(SName+"MTM"));
//PopupWindow(CoverMessage, Name(),10,700,50);
//Telegram(BOTKEY,CHANNELID,CoverMessage); 
}

//Reset
if(Reset)
{
StaticVarSet(SName+"INUPTRADE",0);
StaticVarSet(SName+"INDNTRADE",0);
StaticVarSet(SName+"UPENTRY",0);
StaticVarSet(SName+"DNENTRY",0);
StaticVarSet(SName+"UPExitTime", 0);
StaticVarSet(SName+"DNExitTime", 0);
}

//Dashboard-----------------------------------------------------
BoardColor = IIf(StaticVarGet(SName+"INUPTRADE"),colorPaleGreen, IIf(StaticVarGet(SName+"INDNTRADE"),colorPink, IIf(EnAlgo  AND FLASESSIONOK1, colorYellow, colorWhite)));
GfxSetBkColor(BoardColor);
GfxSelectSolidBrush(BoardColor);
GfxRoundRect(PX*1, PY*10, PX*25, PY*18,PX,PX);

If(StaticVarGet(SName+"INUPTRADE"))
{
GfxTextOut(Name()+" Qty "+QTY+" TO "+TDVAL, PX*2, PY*11);
GfxTextOut("Entry "+UPENTRY+" PNL "+UPPNL,PX*2, PY*13);
GfxTextOut( "MTM "+MTM , PX*2, PY*15);
}
else If(StaticVarGet(SName+"INDNTRADE"))
{
GfxTextOut(Name()+" Qty "+QTY+" TO "+TDVAL, PX*2, PY*11);
GfxTextOut("Entry "+DNENTRY+" PNL "+DNPNL,PX*2, PY*13);
GfxTextOut( "MTM "+MTM , PX*2, PY*15);
}
else if(EnAlgo) 
{
if(!FLASESSIONOK1)GfxTextOut("Not Logged In", PX*2, PY*13); 
else 
{
GfxTextOut(Name()+" Qty "+QTY+" TO "+TDVAL, PX*2, PY*11);
GfxTextOut("MTM "+MTM , PX*2, PY*15);
}
}

