RequestTimedRefresh(1,False);

//Defaults
ND = Day() != Ref(Day(),-1);
ED = Day()!= Ref(Day(), 1);
TN = TimeNum();
CZ = LastValue(C);
TZ = LastValue(TN);

//Strategy Code Start---------------------------------
Buy = Sell = Short = Cover = 0;
//Strategy Code End -----------------------------------------

//Chart Code Start ----------------------------
_N(Title = StrFormat("{{NAME}} - {{INTERVAL}} {{DATE}} O %g, H %g, L %g, C %g  {{VALUES}}", O, H, L, C  ));
SetChartOptions(0,chartShowArrows|chartShowDates);
SetBarFillColor( IIf( C > O, ColorRGB( 0, 75, 0 ), IIf( C <= O, ColorRGB( 75, 0, 0 ), colorLightGrey ) ) );
Plot( C, "", IIf( C > O, ColorRGB( 0, 255, 0 ), IIf( C <= O, ColorRGB( 255, 0, 0 ), colorLightGrey ) ), 64, Null, Null, 0, 0, 1 );

//Indicators
TimeFrameSet(inDaily);
PDH =  Ref(H,-1); PDL =  Ref(L,-1); PDC =  Ref(C,-1);
TimeFrameRestore();

PDH =  TimeFrameExpand(PDH, inDaily,expandFirst);    
PDL =  TimeFrameExpand(PDL, inDaily,expandFirst);
PDC =  TimeFrameExpand(PDC, inDaily,expandFirst);

PWH =  TimeFrameGetPrice("H", inWeekly, -1);    
PWL =  TimeFrameGetPrice("L", inWeekly, -1);

//Pivot Points
DPP=(PDH+PDL+PDC)/3;
DR1=(2*DPP)-PDL;
DR2=DPP+(PDH-PDL);
DR3=PDH+2*(DPP-PDL);
DS1=(2*DPP)-PDH;
DS2=DPP-(PDH-PDL);
DS3=PDL-2*(PDH-DPP);
//CPR
DLB = (PDH+PDL) / 2;
DUB = (2*DPP) - DLB;
//CPR TOP and Bottom
TCPR = Prec(Max(DLB,DUB),1);
BCPR = Prec(Min(DLB,DUB),1);

//Previous Day PP, CPR Top Bottom
PDPP   = ValueWhen(ND,Ref(DPP,-1));
PTCPR = ValueWhen(ND,Ref(TCPR,-1));
PBCPR = ValueWhen(ND,Ref(BCPR,-1));
//Narrow CPR
CPR = (abs(DUB-DLB) / C)*100;
NCPR = (CPR < 0.05);
//Higher High CPR
HHCPR = BCPR > PTCPR;
//Lower Low CPR
LLCPR = TCPR < PBCPR;
//Inside CPR
ICPR = PTCPR > TCPR AND PBCPR < BCPR;
//Outside CPR
OCPR = PTCPR < TCPR AND PBCPR > BCPR;

//VWAP 
if (Name() == "NIFTY" ) V = Foreign("NIFTY-I","V");
Bars = BarsSince(ED);
NDV = Sum(V,Bars);
VWAP = Sum (Avg * V, Bars)/NDV;


INTRADAY = Interval() <= 1800;

if(INTRADAY)
{
Plot (IIf(ED,Null,VWAP),"VWAP",colorCustom11,styleNoLabel);

Plot( IIf(ED,Null,PDH),"", colorRed, styleNoLabel|styleNoRescale|styleDashed);
Plot( IIf(ED,Null,PDL),"", colorLime, styleNoLabel|styleNoRescale|styleDashed);

PlotText("PDH",LastValue(BarIndex()+1),LastValue(PDH),colorRed,colorDefault,-5);
PlotText("PDL",LastValue(BarIndex()+1),LastValue(PDL),colorLime,colorDefault,-5);

Plot( IIf(ED,Null,PWH),"", colorRed, styleNoLabel|styleNoRescale|styleDots);
Plot( IIf(ED,Null,PWL),"", colorLime, styleNoLabel|styleNoRescale|styleDots);

PlotText("PWH",LastValue(BarIndex()+1),LastValue(PWH),colorRed,colorDefault,-5);
PlotText("PWL",LastValue(BarIndex()+1),LastValue(PWL),colorLime,colorDefault,-5);

Plot( IIf(ED,Null,DR3),"", colorRed, styleNoLabel|styleNoRescale);
Plot( IIf(ED,Null,DR2),"", colorRed, styleNoLabel|styleNoRescale);
Plot( IIf(ED,Null,DR1),"", colorRed, styleNoLabel|styleNoRescale);
Plot( IIf(ED,Null,DPP),"", colorAqua, styleNoLabel|styleNoRescale);
Plot( IIf(ED,Null,DS1),"", colorLime, styleNoLabel|styleNoRescale);
Plot( IIf(ED,Null,DS2),"", colorLime, styleNoLabel|styleNoRescale);
Plot( IIf(ED,Null,DS3),"", colorLime, styleNoLabel|styleNoRescale);

PlotText("DR3",LastValue(BarIndex()+1),LastValue(DR3),colorRed,colorDefault,-5);
PlotText("DR2",LastValue(BarIndex()+1),LastValue(DR2),colorRed,colorDefault,-5);
PlotText("DR1",LastValue(BarIndex()+1),LastValue(DR1),colorRed,colorDefault,-5);
PlotText("DS1",LastValue(BarIndex()+1),LastValue(DS1),colorLime,colorDefault,-5);
PlotText("DS2",LastValue(BarIndex()+1),LastValue(DS2),colorLime,colorDefault,-5);
PlotText("DS3",LastValue(BarIndex()+1),LastValue(DS3),colorLime,colorDefault,-5);


//Cloud
NDTCPR = IIf(ED,Null,TCPR);
NDBCPR = IIf(ED,Null,BCPR);
ColorCPR = IIf(NCPR OR ICPR OR OCPR,ColorRGB(196,196,128),IIf(HHCPR,ColorRGB(0,48,0),IIf(LLCPR,ColorRGB(48,0,0),ColorRGB(0,0,48))));
PlotOHLC( NDTCPR, NDTCPR, NDBCPR, NDBCPR, "", ColorCPR, styleNoLabel | styleCloud | styleNoRescale, Null, Null,0,-1);
}

//Chart Code End ---------------------------------------

//Option Symbol

function OPSYM(iDatafeed,iName,iStrike,iOption,iDate,iWeekly,iExchange,iSuffix)
{
	//Kotak
	if(iDatafeed == "Kotak")
		{
		FTMM = DateTimeFormat("%#m",iDate);
		if(iWeekly==1)		result = iName+DateTimeFormat("%y",iDate)+WriteIf(StrToNum(FTMM) > 9, StrLeft( DateTimeFormat("%b",iDate),1),FTMM)+DateTimeFormat("%d",iDate)+iStrike+iOption;
		else		result = iName+DateTimeFormat("%y",iDate)+StrToUpper( DateTimeFormat("%b",iDate))+iStrike+iOption;
		}
	else 
	//Flattrade
	if(iDatafeed == "Flattrade" )
		{
		if(iExchange == "BFO")
		{
		FTMM = DateTimeFormat("%#m",iDate);
		if(iWeekly==1)		result = iName+DateTimeFormat("%y",iDate)+WriteIf(StrToNum(FTMM) > 9, StrLeft( DateTimeFormat("%b",iDate),1),FTMM)+DateTimeFormat("%d",iDate)+iStrike+iOption;
		else		result = iName+DateTimeFormat("%y",iDate)+StrToUpper( DateTimeFormat("%b",iDate))+iStrike+iOption;
		}
		else
		{
		result = iName+DateTimeFormat("%d",iDate)+StrToUpper( DateTimeFormat("%b",iDate))+DateTimeFormat("%y",iDate)+StrTrim(iOption,"E")+iStrike;		
		}
		}	
	else
	//Amifeed
	if(iDatafeed == "Amifeed")
		{
		if(iWeekly==1)		result = iName+"WK"+iStrike+iOption;
		else		result = iName+iStrike+iOption;
		}	
	else  	
	//Valvenet VBiz BestRT
	if(iDatafeed == "VBiz")
		{
		if(iWeekly==1)		result = iName+"_"+iStrike+iOption+"-"+DateTimeFormat("%d",iDate) + StrToUpper(DateTimeFormat("%b",iDate)) + DateTimeFormat("%Y",iDate);
		else		result = iName+"_"+iStrike+iOption+"-"+"I";
		}
	else	
	
	//EqualSolutions
	if(iDatafeed == "EqualSolutions")
		{
		if(iWeekly==1)		result = iName+DateTimeFormat("%y",iDate)+StrToUpper( DateTimeFormat("%b",iDate))+DateTimeFormat("%d",iDate)+"_"+iStrike+iOption;
		else		result = iName+DateTimeFormat("%y",iDate)+StrToUpper( DateTimeFormat("%b",iDate))+"_"+iStrike+iOption;
		}	 
	//EST
	else if(iDatafeed == "EST" )
		{
		result = iName+iStrike+iOption+iSuffix;
		}	
		else		
	//Default
		{
		result = iName+iStrike+iOption;
		}
    return result;    
}


//Parameters
_SECTION_BEGIN("Kotak Underlying Chart to Options Order");

EXPDATEN5 = ParamDate( "Expiry Date N50", Now(1), 2 );
EXPDATESX = ParamDate( "Expiry Date SEN", Now(1), 2 );
EXPDATEME = ParamDate( "Monthly Expiry Date", Now(1), 2 );

ISWKYN5 = ParamToggle( "Weekly|Monthly N50", "Monthly|Weekly",1);
ISWKYSX = ParamToggle( "Weekly|Monthly SEN", "Monthly|Weekly",1);

UPNSTRK = Param("Strikes from ATM UPTrend", 0, -50 ,50,1);
DNNSTRK = Param("Strikes from ATM DNTrend", 0, -50 ,50,1);
LOTS = Param("No. of Lots",1,1,50);

EnAlgo = ParamToggle("Enable Algo","No|Yes",1);
EnOrdNo = ParamToggle("Need Order No","No|Yes",1);

LMTOFS = Param("Limit Order Offset in %", 5,0.0,10,0.1)/100;
DFEED = ParamList("Data Feed", "EST|Amifeed|VBiz|EqualSolutions",0);
OPTFIX = ParamList("Options suffix", "|-I|-II|-III",1);

OUTPATH = ParamStr("Path to Save Response","R:\\");
STGTAG = ParamStr("Strategy Tag","U2O");

HX = Param("Button Horizontal Position",0,0,164);
HY = Param("Button Vertical Position",0,0,89);
_SECTION_END();

//Prefix for Static Variable
SName = STGTAG+"NEO"+Name()+Interval();



if (StrFind( Name(), "SENSEX" ))
{
SPNAME = "SENSEX";
STRDIF = 100;
EXPDATE = EXPDATESX;
ISWKY = ISWKYSX;
LOTSIZE = 20;
EXCHANGE = "bse_fo";
}
else if(StrFind( Name(), "BANKNIFTY" ))
{
SPNAME = "BANKNIFTY";
STRDIF = 100;
EXPDATE = EXPDATEME;
ISWKY = 0;//ISWKYBN;
LOTSIZE = 30;
EXCHANGE = "nse_fo";
}
else if (StrFind( Name(), "NIFTY" ))
{
SPNAME = "NIFTY";
STRDIF = 50;
EXPDATE = EXPDATEN5;
ISWKY = ISWKYN5;
LOTSIZE = 65;
EXCHANGE = "nse_fo";
}
else
{
SPNAME = Name();
STRDIF = PointValue;
EXPDATE = GetFnData("DividendPayDate");
ISWKY = 0;
LOTSIZE = RoundLotSize;
EXCHANGE = GroupID(1);
}

//ATM
ATM = Round(CZ/STRDIF) * STRDIF;

ATMCE = OPSYM(DFEED,SPNAME,NumToStr(ATM,1.0,False),"CE",EXPDATE,ISWKY,EXCHANGE,OPTFIX);
ATMPE = OPSYM(DFEED,SPNAME,NumToStr(ATM,1.0,False),"PE",EXPDATE,ISWKY,EXCHANGE,OPTFIX);

ATMCEC = LastValue(Foreign(ATMCE,"C"));
ATMPEC = LastValue(Foreign(ATMPE,"C"));
IFUTC = ATM + ATMCEC - ATMPEC;
ATM = Round(IFUTC/STRDIF) * STRDIF;

//Checking Expiry date
EXPIRYOK = EXPDATE >= Now(5);

//Button-------------------------------------------
PX = 10;//round(Status("pxwidth")/164);
PY = 10;//round(Status("pxheight")/89);

Reset = 0;

GuiButton( "Buy CE", 1,  PX*1+PX*HX, PY*2+PY*HY, PY*6, PY*3, notifyClicked );
GuiButton( "Sell CE", 2,  PX*8+PX*HX, PY*2+PY*HY, PY*6, PY*3, notifyClicked );

GuiButton( "Buy PE", 3,  PX*1+PX*HX, PY*6+PY*HY, PY*6, PY*3, notifyClicked );
GuiButton( "Sell PE", 4,  PX*8+PX*HX, PY*6+PY*HY, PY*6, PY*3, notifyClicked );

GuiButton( "Reset", 5, PX*15+PX*HX, PY*2+PY*HY, PY*6, PY*3, notifyClicked );

GuiSetColors( 1, 2, 2, colorBlack, colorLime,colorGreen,-1,colorGreen);
GuiSetColors( 3, 4, 2, colorYellow, colorOrange,colorRed,-1,colorRed);
GuiSetColors( 5, 6, 2, colorBlack, colorYellow, colorGold,-1,colorGold); 

function HandleEvents() 
{ 
    for ( n = 0;id = GuiGetEvent( n, 0 );n++ )
    { 
        code = GuiGetEvent( n, 1 ); 

         switch ( id ) 
        { 
             case 1:                                   
             Buy = 1;             
             break; 
             
             case 2: 
             Sell = 1;
             break;              

             case 3:
             Short = 1;
             break; 

             case 4: 
             Cover = 1;
             break; 
             
             case 5: 
             Reset = 1;
             break;                                      
        } 
    } 
} 
HandleEvents();
//Button Code End--------------------------------------

//Order Place Code Start-----------------------------------------------------------
NEO_KEY = "neotradeapi";

function KotakOrder(TRA_TYP,TRD_SYM,QTY,PRIC,TRG_PRI,PR_TYP,PRODUCT,EXC,SES_ID,ACS_TOK,ORD_URL,KEY,OUT)
{
ShellExecute("Curl.exe","-X POST \""+ORD_URL+"\" -H \"accept: application/json\" -H \"Auth: "+ACS_TOK+"\" -H \"Sid: "+SES_ID+"\" -H \"neo-fin-key: "+KEY+"\"  -H \"Content-Type: application/x-www-form-urlencoded\" -d \"jData={\\\"am\\\":\\\"NO\\\",\\\"dq\\\":\\\"0\\\",\\\"es\\\":\\\""+EXC+"\\\",\\\"mp\\\":\\\"0\\\",\\\"pc\\\":\\\""+PRODUCT+"\\\",\\\"pf\\\":\\\"N\\\",\\\"pr\\\":\\\""+PRIC+"\\\",\\\"pt\\\":\\\""+PR_TYP+"\\\",\\\"qt\\\":\\\""+QTY+"\\\",\\\"rt\\\":\\\"DAY\\\",\\\"tp\\\":\\\""+TRG_PRI+"\\\",\\\"ts\\\":\\\""+TRD_SYM+"\\\",\\\"tt\\\":\\\""+TRA_TYP+"\\\"}\"  "+OUT+"","",0);
return;
}

/*
//Telegram Alert Function
function Telegram(Key,ID,Message)
{
ih = InternetOpenURL("https://api.telegram.org/bot"+Key+"/sendMessage?chat_id="+ID+"&text="+Message); 
if(ih) InternetClose( ih );
return ;
}

//Telegram
BOTKEY = ParamStr("Telegram Bot Key","");
CHANNELID = ParamStr("Channel ID","");

*/

NEOACSTOK1 = StaticVarGetText("NEOACSTOK"+"1");//"1" - User Number
NEOSESID1 = StaticVarGetText("NEOSESID"+"1");//"1" - User Number
NEOBASEURL1 = StaticVarGetText("NEOBASEURL"+"1");//"1" - User Number
NEOORDURL1 = NEOBASEURL1+"/quick/order/rule/ms/place";

NEOSESSIONOK1 = NEOACSTOK1 != "" AND NEOSESID1 != "";

NEOOUTRESP1 = WriteIf(EnOrdNo,"-o "+OUTPATH+"\\"+Name()+"1"+".txt","");//"1" - User Number

//Quantity
QTY = ""+LOTS * LOTSIZE;

//Order Place Function Parameters: Buy/Sell, Symbol, Quantity, Price,Trigger Price, PriceType MKT, L, SL, SL-M, Product NRML,CNC,MIS,CO, EXCHANGE nse_cm, bse_cm, nse_fo, bse_fo, cde_fo, mcx_fo,API Credentials,Respone enable and path

//Buy---------------------------------------------------------------------------------------------------
if (LastValue(Buy) AND Nz(StaticVarGet(SName+"INUPTRADE")) == 0  AND Nz(StaticVarGet(SName+"INDNTRADE")) == 0 AND Nz(StaticVarGet(SName+"UPExitTime")) != TZ)
{
StaticVarSet(SName+"BATM",LastValue(ATM));
UPSTKB = OPSYM("Kotak",SPNAME,StaticVarGet(SName+"BATM")+(UPNSTRK*STRDIF),"CE",EXPDATE,ISWKY,EXCHANGE,OPTFIX);
OPSYMCE = OPSYM(DFEED,SPNAME,StaticVarGet(SName+"BATM")+(UPNSTRK*STRDIF),"CE",EXPDATE,ISWKY,EXCHANGE,OPTFIX);
UPSTKBC = LastValue(Foreign(OPSYMCE,"C"));
UPBUYOFS = round(UPSTKBC * (1+LMTOFS));
UPBUYOFSS = ""+UPBUYOFS;

if(EnAlgo  AND NEOSESSIONOK1) KotakOrder("B",UPSTKB,QTY,"0","0","MKT","NRML",EXCHANGE,NEOSESID1,NEOACSTOK1,NEOORDURL1,NEO_KEY,NEOOUTRESP1);

StaticVarSet(SName+"INUPTRADE",1);
StaticVarSet(SName+"INUPTRADE"+"ENTRY",UPSTKBC);

BuyMessage = "Buy "+UPSTKB+" - "+QTY+" @ "+UPSTKBC;
_TRACE(BuyMessage);

//PopupWindow(BuyMessage, Name(),5,800,50);
//Telegram(BOTKEY,CHANNELID,BuyMessage); 
}

UPSTKB = OPSYM("Kotak",SPNAME,StaticVarGet(SName+"BATM")+(UPNSTRK*STRDIF),"CE",EXPDATE,ISWKY,EXCHANGE,OPTFIX);
OPSYMCE = OPSYM(DFEED,SPNAME,StaticVarGet(SName+"BATM")+(UPNSTRK*STRDIF),"CE",EXPDATE,ISWKY,EXCHANGE,OPTFIX);
UPSTKBC = LastValue(Foreign(OPSYMCE,"C"));
UPSELOFS = round(UPSTKBC * (1-LMTOFS));
UPSELOFSS = ""+UPSELOFS;
UPENTRY = StaticVarGet(SName+"INUPTRADE"+"ENTRY") ;
UPPNL = round((UPSTKBC - UPENTRY)*LOTSIZE);

MTM = Nz(StaticVarGet(SName+"MTM"));

//Sell---------------------------------------------------------------------------------------------------
if (LastValue(Sell)  AND StaticVarGet(SName+"INUPTRADE"))
{
if(EnAlgo AND NEOSESSIONOK1) KotakOrder("S",UPSTKB,QTY,"0","0","MKT","NRML",EXCHANGE,NEOSESID1,NEOACSTOK1,NEOORDURL1,NEO_KEY,NEOOUTRESP1);

StaticVarSet(SName+"INUPTRADE",0);
StaticVarSet(SName+"UPExitTime",TZ);
StaticVarSet(SName+"MTM", MTM+UPPNL);

SellMessage = "Sell "+UPSTKB+" - "+QTY+" @ "+UPSTKBC;
_TRACE(SellMessage);
_TRACE("PNL "+UPPNL);
_TRACE("MTM "+StaticVarGet(SName+"MTM"));

//PopupWindow(SellMessage, Name(),5,800,50);
//Telegram(BOTKEY,CHANNELID,SellMessage); 
}

//Short---------------------------------------------------------------------------------------------------
if (LastValue(Short) AND Nz(StaticVarGet(SName+"INUPTRADE")) == 0 AND Nz(StaticVarGet(SName+"INDNTRADE")) == 0  AND Nz(StaticVarGet(SName+"DNExitTime")) != TZ)
{
StaticVarSet(SName+"SATM",LastValue(ATM));
DNSTKB = OPSYM("Kotak",SPNAME,StaticVarGet(SName+"SATM")-(DNNSTRK*STRDIF),"PE",EXPDATE,ISWKY,EXCHANGE,OPTFIX);
OPSYMPE = OPSYM(DFEED,SPNAME,StaticVarGet(SName+"SATM")-(DNNSTRK*STRDIF),"PE",EXPDATE,ISWKY,EXCHANGE,OPTFIX);
DNSTKBC = LastValue(Foreign(OPSYMPE,"C"));
DNBUYOFS = round(DNSTKBC * (1+LMTOFS));
DNBUYOFSS = ""+DNBUYOFS;

if(EnAlgo AND NEOSESSIONOK1) KotakOrder("B",DNSTKB,QTY,"0","0","MKT","NRML",EXCHANGE,NEOSESID1,NEOACSTOK1,NEOORDURL1,NEO_KEY,NEOOUTRESP1);

StaticVarSet(SName+"INDNTRADE",1);
StaticVarSet(SName+"INDNTRADE"+"ENTRY",DNSTKBC);

ShortMessage = "Buy "+DNSTKB+" - "+QTY+" @ "+DNSTKBC;
_TRACE(ShortMessage);

//PopupWindow(ShortMessage, Name(),10,300,50);
//Telegram(BOTKEY,CHANNELID,ShortMessage);  
}

DNSTKB = OPSYM("Kotak",SPNAME,StaticVarGet(SName+"SATM")-(DNNSTRK*STRDIF),"PE",EXPDATE,ISWKY,EXCHANGE,OPTFIX);
OPSYMPE = OPSYM(DFEED,SPNAME,StaticVarGet(SName+"SATM")-(DNNSTRK*STRDIF),"PE",EXPDATE,ISWKY,EXCHANGE,OPTFIX);
DNSTKBC = LastValue(Foreign(OPSYMPE,"C"));
DNSELOFS = round(DNSTKBC * (1-LMTOFS));
DNSELOFSS = ""+DNSELOFS;

DNENTRY = StaticVarGet(SName+"INDNTRADE"+"ENTRY") ;
DNPNL = round((DNSTKBC - DNENTRY)*LOTSIZE);

//Cover---------------------------------------------------------------------------------------------------
if (LastValue(Cover)  AND StaticVarGet(SName+"INDNTRADE") )
{
if(EnAlgo  AND NEOSESSIONOK1) KotakOrder("S",DNSTKB,QTY,"0","0","MKT","NRML",EXCHANGE,NEOSESID1,NEOACSTOK1,NEOORDURL1,NEO_KEY,NEOOUTRESP1);

StaticVarSet(SName+"INDNTRADE",0);
StaticVarSet(SName+"DNExitTime",TZ);
StaticVarSet(SName+"MTM", MTM+DNPNL);

CoverMessage = "Sell "+DNSTKB+" - "+QTY+" @ "+DNSTKBC;
_TRACE(CoverMessage);
_TRACE("PNL "+DNPNL);
_TRACE("MTM "+StaticVarGet(SName+"MTM"));

//PopupWindow(CoverMessage, Name(),10,700,50);
//Telegram(BOTKEY,CHANNELID,CoverMessage); 
}

//Reset
if(Reset)
{
StaticVarSet(SName+"BATM",LastValue(ATM));
StaticVarSet(SName+"SATM",LastValue(ATM));
StaticVarSet(SName+"INUPTRADE",0);
StaticVarSet(SName+"INDNTRADE",0);
StaticVarSet(SName+"UPExitTime",0);
StaticVarSet(SName+"DNExitTime",0);
}


//Dashboard-----------------------------------------------------
BoardColor = IIf(StaticVarGet(SName+"INUPTRADE"),colorPaleGreen, IIf(StaticVarGet(SName+"INDNTRADE"),colorPink, IIf(EnAlgo AND NEOSESSIONOK1 AND EXPIRYOK, colorYellow, colorWhite)));
GfxSetBkColor(BoardColor);
GfxSelectSolidBrush(BoardColor);
GfxRoundRect(PX*1, PY*10, PX*25, PY*18,PX,PX);

If(StaticVarGet(SName+"INUPTRADE"))
{
GfxTextOut(UPSTKB+" "+UPSTKBC, PX*2, PY*11);
GfxTextOut( "Entry "+UPENTRY+"   PnL "+UPPNL , PX*2, PY*13);
GfxTextOut( "MTM "+MTM , PX*2, PY*15);
}
else If(StaticVarGet(SName+"INDNTRADE"))
{
GfxTextOut(DNSTKB+" "+DNSTKBC, PX*2, PY*11);
GfxTextOut( "Entry "+DNENTRY+"   PnL "+DNPNL , PX*2, PY*13);
GfxTextOut( "MTM "+MTM , PX*2, PY*15);
}
else if(EnAlgo) 
{
if(!EXPIRYOK)GfxTextOut("Check Expiry Date", PX*2, PY*13);  
else if(!NEOSESSIONOK1)GfxTextOut("Not Logged In", PX*2, PY*13); 
else
{
GfxTextOut(UPSTKB+" "+UPSTKBC, PX*2, PY*11);
GfxTextOut(DNSTKB+" "+DNSTKBC, PX*2, PY*13);
GfxTextOut( "LOTS "+LOTS+" MTM "+MTM , PX*2, PY*15);
}
}
