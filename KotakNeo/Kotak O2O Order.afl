RequestTimedRefresh(1,False);

//Strategy Code Start---------------------------------
Buy = Sell = 0;
//Strategy Code End ----------------------------------

_SECTION_BEGIN("Kotak Options to Options");
DFEED = ParamList("Data Feed", "EST|Amifeed|VBiz|EqualSolutions",0);
OPTFIX = ParamList("Options suffix", "|-I|-II|-III",1);
EXPDATEN5 = ParamDate( "Expiry Date N50", Now(1), 2 );
EXPDATEBN = ParamDate( "Expiry Date BNF", Now(1), 2 );
EXPDATESX = ParamDate( "Expiry Date SEN", Now(1), 2 );

ISWKYN5 = ParamToggle( "Weekly|Monthly N50", "Monthly|Weekly",1);
ISWKYSX = ParamToggle( "Weekly|Monthly SEN", "Monthly|Weekly",1);

EnAlgo = ParamToggle("Enable Place Order","No|Yes",1);
EnOrdNo = ParamToggle("Need Order No","No|Yes",1);
LOTS = Param("No. of Lots",1,1,50);
LMTOFS = Param("Limit Order Offset in %", 5,0.0,20,0.1)/100;
PLOTOI = ParamList("Plot OI","Cloud,StairCase,None",0);
PLOTRSI = ParamToggle("Plot RSI", "No|Yes",1);
RSIP = Param("RSI Period",14,1,200,10);
RSIOZ = Param("RSI OverZone 60/40 = 10",0,0,50,5);
OUTPATH = ParamStr("Path to Save Response","R:\\");
HX = Param("Button Horizontal Position",0,0,164);
HY = Param("Button Vertical Position",0,0,89);
_SECTION_END();

//Defaults
ND = Day() != Ref(Day(),-1);
ED = Day()!= Ref(Day(), 1);
TN = TimeNum();
CZ = LastValue(C);
TZ = LastValue(TN);
Bars = 1 + BarsSince(ND);
NDV = Sum(V,Bars);

function SYMEXTR(iDatafeed,iName,iDate)
{
	//Amifeed
	if(iDatafeed == "Amifeed")
		{
		result = StrReplace(iName,"WK","");
		}	
	else 	
	//Valvenet VBiz BestRT
	if(iDatafeed == "VBiz")
		{
		iDATEDMY = DateTimeFormat("%d",iDate) + StrToUpper(DateTimeFormat("%b",iDate)) + DateTimeFormat("%Y",iDate);
		result = StrReplace(StrReplace(StrReplace(iName,"_",""),"-",""),iDATEDMY,"");
		}
	else
	//Equalsolutions
	if(iDatafeed == "EqualSolutions")
		{
		iDATEYM = DateTimeFormat("%y",iDate)+StrToUpper( DateTimeFormat("%b",iDate));
		iDATED = DateTimeFormat("%d",iDate);
		result = StrReplace(StrReplace(StrReplace(iName,"_",""),iDATEYM,""),iDATED,"");
		}
	else
		
	//Default
		{
		result = iName;
		}
    return result;    
}

//Chart Code Start================================

_N(Title = StrFormat("{{NAME}} - {{INTERVAL}} {{DATE}} O %g, H %g, L %g, C %g, V %g  {{VALUES}}", O, H, L, C, V  ));
SetChartOptions( 1, chartShowDates, chartGridMiddle, 0, 0, 0 );
SetBarFillColor( IIf( C > O, ColorRGB( 0, 75, 0 ), IIf( C <= O, ColorRGB( 75, 0, 0 ), colorLightGrey ) ) );
Plot( C, "", IIf( C > O, ColorRGB( 0, 255, 0 ), IIf( C <= O, ColorRGB( 255, 0, 0 ), colorLightGrey ) ), 64, Null, Null, 0, 0, 1 );

//Indictors
//VWAP
VWAP = Sum (Avg * V, Bars)/NDV;
Plot (IIf(ED,Null,VWAP),"VWAP",colorCustom11,styleNoLabel);

//OI
if(PLOTOI == "StairCase")
{
ColorOI = IIf(OI > Ref(OI,-1), colorRed,IIf(OI < Ref(OI,-1),colorBrightGreen,colorDefault));
Plot(OI,"",ColorOI ,styleStaircase|styleLeftAxisScale,0,0,0,0,2);
}
if(PLOTOI == "Cloud")
{
OIMA = MA(OI,8);
ColorOI = IIf(OI > OIMA,colorDarkRed,colorDarkGreen);
PlotOHLC( OI, OI, OIMA, OIMA, "", ColorOI, styleNoLabel | styleCloud | styleLeftAxisScale, Null, Null );
}

//Volume
PaneHght = 15;//Param( "Volume Pane Height (in %)", 15, 1, 100, 1 );
PaneHghtMin = LowestVisibleValue( V);
PaneHghtMax = HighestVisibleValue(V) * 100 / PaneHght;
gxs= 15;//Param("GRAPH spaceing",15,5,50,5); 
GraphXSpace = gxs;
ColorVolume = IIf( C > O, ColorRGB( 0, 255, 0 ), IIf( C <= O, ColorRGB( 255, 0, 0 ), colorLightGrey ) );
MAV=MA(Volume,50);
Plot( MAV, "MAV50", colorblue, styleOwnScale | styleNoLabel   ,  PaneHghtMin, PaneHghtMax, 0, 0, 2 );
Plot( V, "V", ColorVolume ,  styleHistogram | styleOwnScale | styleThick | styleNoLabel , PaneHghtMin, PaneHghtMax, 0, 0, 2 );

//RSI
if(PLOTRSI)
{
RSI0 = RSI(RSIP);
ColorRSI = IIf(RSI0>50+RSIOZ,colorGreen,IIf(RSI0<50-RSIOZ,colorRed,colorDarkGrey));
Plot( 98, "", ColorRSI,  styleDots | styleThick | styleNoLine | styleOwnScale | styleNoLabel, 1, 100,0,0,5);
}

//Chart Code End ===================================

//Prefix for Static Variable
STGTAG = "O2O";
SName = STGTAG+"NEO"+Name()+Interval();

Symbol = Name();

if (StrFind( Name(), "SENSEX" ))
{
SPNAME = "SENSEX";
STRDIF = 100;
EXPDATE = EXPDATESX;
ISWKY = ISWKYSX;
LOTSIZE = 20;
EXCSEG = "bse_fo";
}
else if(StrFind( Name(), "BANKNIFTY" ))
{
SPNAME = "BANKNIFTY";
STRDIF = 100;
EXPDATE = EXPDATEME;
ISWKY = 0;//ISWKYBN;
LOTSIZE = 35;
EXCSEG = "nse_fo";
}
else if (StrFind( Name(), "NIFTY" ))
{
SPNAME = "NIFTY";
STRDIF = 50;
EXPDATE = EXPDATEN5;
ISWKY = ISWKYN5;
LOTSIZE = 65;
EXCSEG = "nse_fo";
}
else
{
SPNAME = Name();
STRDIF = 1;
EXPDATE = EXPDATEME;
ISWKY = 0;
LOTSIZE = 10;
EXCSEG = "nse_fo";
}

CEPEFUL = WriteIf(StrFind(Name(),"PE"+OPTFIX),"PE"+OPTFIX,"CE"+OPTFIX);

STRIKE = StrReplace(StrReplace(Name(),SPNAME,""),CEPEFUL,"");
STRIKE = SYMEXTR(DFEED,STRIKE,EXPDATE);

CEPE = WriteIf(StrFind(Name(),"PE"+OPTFIX),"PE","CE");

FTMM = DateTimeFormat("%#m",EXPDATE);
EXPDATEW = DateTimeFormat("%y",EXPDATE)+WriteIf(StrToNum(FTMM) > 10, StrLeft( DateTimeFormat("%b",EXPDATE),1),FTMM)+DateTimeFormat("%d",EXPDATE);
EXPDATEM = DateTimeFormat("%y",EXPDATE)+StrToUpper( DateTimeFormat("%b",EXPDATE));

if(ISWKY) OPNAME = SPNAME+EXPDATEW+STRIKE+CEPE;
else OPNAME = SPNAME+EXPDATEM+STRIKE+CEPE;

//Button Code Start----------------------------------------------------
PX = 10;//round(Status("pxwidth")/164);
PY = 10;//round(Status("pxheight")/89);

Reset = 0;

GuiButton( "Buy "+CEPEFUL, 2,  PX*1+PX*HX, PY*2+PY*HY, PY*6, PY*3, notifyClicked );
GuiButton( "Sell "+CEPEFUL, 3,  PX*8+PX*HX, PY*2+PY*HY, PY*6, PY*3, notifyClicked );

GuiButton( "Reset", 6, PX*15+PX*HX, PY*2+PY*HY, PY*6, PY*3, notifyClicked );

GuiSetColors( 2, 2, 2, colorBlack, colorLime,colorGreen,-1,colorGreen);
GuiSetColors( 3, 3, 2, colorYellow, colorOrange,colorRed,-1,colorRed);
GuiSetColors( 6, 6, 2, colorBlack, colorYellow, colorGold,-1,colorGold );

function HandleEvents() 
{ 
    for ( n = 0;id = GuiGetEvent( n, 0 );n++ )
    { 
        code = GuiGetEvent( n, 1 ); 

         switch ( id ) 
        { 
             case 2:  
             _TRACE("Buy");                                 
             Buy = 1;             
             break; 
             
             case 3: 
             Sell = 1;
             break;              
             
             case 6: 
             Reset = 1;
             break;                                      
        } 
    } 
} 
HandleEvents();

if(Reset)
{
StaticVarSet(SName+"INUPTRADE",0);
StaticVarSet(SName+"UPENTRY",0);
StaticVarSet(SName+"UPExitTime",0);

}

//Button Code End--------------------------------------

//Order Place Code Start-----------------------------------------------------------
NEO_KEY = "neotradeapi";

function KotakOrder(TRA_TYP,TRD_SYM,QTY,PRIC,TRG_PRI,PR_TYP,PRODUCT,EXC,SES_ID,ACS_TOK,ORD_URL,KEY,OUT)
{
ShellExecute("Curl.exe","-X POST \""+ORD_URL+"\" -H \"accept: application/json\" -H \"Auth: "+ACS_TOK+"\" -H \"Sid: "+SES_ID+"\" -H \"neo-fin-key: "+KEY+"\"  -H \"Content-Type: application/x-www-form-urlencoded\" -d \"jData={\\\"am\\\":\\\"NO\\\",\\\"dq\\\":\\\"0\\\",\\\"es\\\":\\\""+EXC+"\\\",\\\"mp\\\":\\\"0\\\",\\\"pc\\\":\\\""+PRODUCT+"\\\",\\\"pf\\\":\\\"N\\\",\\\"pr\\\":\\\""+PRIC+"\\\",\\\"pt\\\":\\\""+PR_TYP+"\\\",\\\"qt\\\":\\\""+QTY+"\\\",\\\"rt\\\":\\\"DAY\\\",\\\"tp\\\":\\\""+TRG_PRI+"\\\",\\\"ts\\\":\\\""+TRD_SYM+"\\\",\\\"tt\\\":\\\""+TRA_TYP+"\\\"}\"  "+OUT+"","",0);
return;
}

/*
//Telegram Alert Function
function Telegram(Key,ID,Message)
{
ih = InternetOpenURL("https://api.telegram.org/bot"+Key+"/sendMessage?chat_id="+ID+"&text="+Message); 
if(ih) InternetClose( ih );
return ;
}

//Telegram
BOTKEY = ParamStr("Telegram Bot Key","");
CHANNELID = ParamStr("Channel ID","");

*/

NEOACSTOK1 = StaticVarGetText("NEOACSTOK"+"1");//"1" - User Number
NEOSESID1 = StaticVarGetText("NEOSESID"+"1");//"1" - User Number
NEOBASEURL1 = StaticVarGetText("NEOBASEURL"+"1");//"1" - User Number
NEOORDURL1 = NEOBASEURL1+"/quick/order/rule/ms/place";

NEOOUTRESP1 = WriteIf(EnOrdNo,"-o "+OUTPATH+"\\"+OPNAME+"NEO"+"1"+".txt","");//"1" - User Number
NEOSESSIONOK1 = NEOACSTOK1 != "" AND NEOSESID1 != "" ;

//Entry Exit Calculations------------------------------------------
QTY = ""+LOTS * LOTSIZE;

//Market Order as Limit Order
LMTOFS = Param("Limit Order Offset in %", 4,0.0,10,0.1)/100;
BUYOFS = ""+round(C * (1+LMTOFS));
SELOFS = ""+round(C * (1-LMTOFS));

//Messages
BuyMessage = "Buy "+OPNAME+" Qty "+QTY+" @ "+CZ;
SellMessage = "Sell "+OPNAME+" Qty "+QTY+" @ "+CZ;

//Order Place Function Parameters: Buy/Sell, Symbol, Quantity, Price,Trigger Price, PriceType MKT, L, SL, SL-M, Product NRML,CNC,MIS,CO, EXCSEG nse_cm, bse_cm, nse_fo, bse_fo, cde_fo, mcx_fo,API Credentials,Respone enable and path

if (LastValue(Buy)  AND Nz(StaticVarGet(SName+"INUPTRADE")) == 0  AND Nz(StaticVarGet(SName+"UPExitTime")) != TZ)
{
if(EnAlgo AND NEOSESSIONOK1) KotakOrder("B",OPNAME,QTY,BUYOFS,"0","L","NRML",EXCSEG,NEOSESID1,NEOACSTOK1,NEOORDURL1,NEO_KEY,NEOOUTRESP1);
_TRACE(BuyMessage);
StaticVarSet(SName+"INUPTRADE",1);
StaticVarSet(SName+CEPE+"UPENTRY",CZ);
//PopupWindow(BuyMessage, Name(),5,800,50);
//Telegram(BOTKEY,CHANNELID,BuyMessage); 
}

PNL = Prec(CZ - StaticVarGet(SName+CEPE+"UPENTRY") ,1);
MTM = Nz(StaticVarGet(SName+"MTM"));

if (LastValue(Sell)  AND StaticVarGet(SName+"INUPTRADE") )
{
if(EnAlgo AND NEOSESSIONOK1) KotakOrder("S",OPNAME,QTY,SELOFS,"0","L","NRML",EXCSEG,NEOSESID1,NEOACSTOK1,NEOORDURL1,NEO_KEY,NEOOUTRESP1);
_TRACE(SellMessage);
StaticVarSet(SName+"MTM", MTM+PNL);
_TRACE("PNL "+PNL);
_TRACE("MTM "+Nz(StaticVarGet(SName+"MTM")));
StaticVarSet(SName+"INUPTRADE",0);
StaticVarSet(SName+"UPExitTime", TZ);
//PopupWindow(SellMessage, Name(),5,800,50);
//Telegram(BOTKEY,CHANNELID,SellMessage); 
}


//Dashboard
BoardColor = IIf(StaticVarGet(SName+"INUPTRADE") AND CEPEFUL == "CE"+OPTFIX, colorPaleGreen,IIf(StaticVarGet(SName+"INUPTRADE") AND CEPEFUL == "PE"+OPTFIX, colorPink,IIf(EnAlgo  AND NEOSESSIONOK1,colorYellow,colorWhite)));
GfxSetBkColor(BoardColor);
GfxSelectSolidBrush(BoardColor);
GfxRoundRect(PX*1, PY*6, PX*28, PY*12,PX,PX);
If(StaticVarGet(SName+"INUPTRADE"))
{
GfxTextOut(OPNAME+" "+CZ, PX*2, PY*7);
GfxTextOut( "Entry "+Prec(StaticVarGet(SName+CEPE+"UPENTRY"),1)+"   PnL "+round(PNL*LotSize)+" MTM "+round(MTM*LotSize) , PX*2, PY*9);
}
else if (EnAlgo AND !NEOSESSIONOK1)GfxTextOut("Not Logged In", PX*2, PY*9);
else
{
GfxTextOut(OPNAME+" "+CZ, PX*2, PY*7);
GfxTextOut( "MTM "+round(MTM*LotSize) , PX*2, PY*9);
}

