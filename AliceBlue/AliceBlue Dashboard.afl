RequestTimedRefresh(1,False);
GfxSetOverlayMode(2);

_SECTION_BEGIN("AliceBlue Backfill");
//Backfill
NUMDAYBF= Param("Number of Days to Backfilll",7,0,750,1);
PARABF = Param("Number of Parallel Backfill",5,1,50,1);
FEEDSCRIPTNAME = ParamList("Feed Script Name","AliceBlue Candle Feed|AliceBlue Tick Feed",0);


_SECTION_BEGIN("AliceBlue Historical Data");
//Historical Data
FILETODOHD =  Paramlist("Historical Data download Master","ScripMaster|NIFTYMaster|BANKNIFTYMaster|SENSEXMaster|NSEEquityFuturesMaster|NSEEquityMaster|EquityMaster|OptionsMaster|OptionsMaster|CRUDEOILMMaster|SILVERMICMaster|IndexMaster|Temp",0);
iEXPDATEHDF = ParamDate("Historical Data from",Now(1),2);
EXPDATEHDF = DateTimeFormat("%d",iEXPDATEHDF)+"-"+StrToUpper( DateTimeFormat("%m",iEXPDATEHDF))+"-"+DateTimeFormat("%Y",iEXPDATEHDF);
iEXPDATEHDT = ParamDate("Historical DataTo",Now(1),2);
EXPDATEHDT = DateTimeFormat("%d",iEXPDATEHDT)+"-"+StrToUpper( DateTimeFormat("%m",iEXPDATEHDT))+"-"+DateTimeFormat("%Y",iEXPDATEHDT);
ENIMPORTDATAHD = ParamList("Import Downloaded Hist Data","Yes|No");
ENDELETEDATAHD = ParamList("Delete DownladedHist Data","Yes|No");
TIMEFRAMEHD= ParamList("Historical Data TimeFrame ","1|D");
PARAHD = Param("Number of Parallel Hist Downloads",5,1,50,1);




_SECTION_BEGIN("AliceBlue Dashboard");
RESPPATH = ParamStr("Path to Response Files","R:\\");
SCRIPTPATH = ParamStr("Path to  Data Files","C:\\API\\Scripts\\");
USERNUM = Param("User Number",1,1,100,1);
EnCMD = ParamToggle("Show CMD Window","No|Yes",1);

LOGINFILE1 = RESPPATH+"AliceBlueLogin"+USERNUM+".txt";
LIMITSFILE1 = RESPPATH+"AliceBlueLimits"+USERNUM+".txt";
LOGINSCRIPT1 = SCRIPTPATH+"AliceBlue Login "+USERNUM+".py";
LIMITSSCRIPT1 = SCRIPTPATH+"AliceBlue Limits "+USERNUM+".py";
FEEDSCRIPT = SCRIPTPATH+FEEDSCRIPTNAME+".py";
HISTSCRIPT = SCRIPTPATH+"AliceBlue HistData.py";



//Button
HX = Param("Button Horizontal Position",0,0,164);
HY = Param("Button Vertical Position",0,0,89);

PX = 10;//round(Status("pxwidth")/164);
PY = 10;//round(Status("pxheight")/89);

GuiButton( "Login",1,  PX*2+PX*HX, PY*4+PY*HY, PX*7, PY*3, notifyClicked );
GuiButton( "Live Data",2,  PX*10+PX*HX, PY*4+PY*HY, PX*7, PY*3, notifyClicked );
GuiButton( "Limits",3,  PX*18+PX*HX, PY*4+PY*HY, PX*7, PY*3, notifyClicked );

GuiButton( "Hist Data",4,  PX*2+PX*HX, PY*8+PY*HY, PX*7, PY*3, notifyClicked );
//GuiButton( "Backfill",5,  PX*10+PX*HX, PY*8+PY*HY, PX*7, PY*3, notifyClicked );


GuiSetColors( 1, 1, 2, colorBlack, colorLime,colorGreen,-1,colorGreen);
GuiSetColors( 2, 6, 2, colorBlack, colorYellow, colorGold,-1,colorGold );


GUIEVEID = GuiGetEvent( 0, 0 );
GUIEVENT = GuiGetEvent( 0, 1 );


//Login
if(GUIEVEID == 1 AND GUIEVENT == 1 )
{
fdelete(LOGINFILE1);
fdelete(LIMITSFILE1);
StaticVarRemove("ALI*");
ShellExecute(LOGINSCRIPT1,"","",EnCMD);
}


