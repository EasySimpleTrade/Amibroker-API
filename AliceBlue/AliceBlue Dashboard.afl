 fh = fopen(LOGINFILE1, "r");

LOGSTATS1 = LOGERROR1 = ACSTOK1 = LOGDATE1 = USERID1 = "";

if (fh)
{
    readingToken = 0;

    while (!feof(fh))
    {
        line = fgets(fh);

        if (readingToken)
        {
            ACSTOK1 = ACSTOK1 + StrTrim(line, "", 2);
        }
        else
        {
            key = StrExtract(line, 0);

            if (key == "token")
            {
                ACSTOK1 = StrTrim(StrExtract(line, 1), "", 2);
                readingToken = 1;
            }
            else
            if (key == "date")
            {
                LOGDATE1 = StrTrim(StrExtract(line, 1), "", 2);
            }
            else
            if (key == "user")
            {
                USERID1 = StrTrim(StrExtract(line, 1), "", 2);
            }
        }
    }

    fclose(fh);
}

printf(""+StrLen( ACSTOK1)+"\n");
NOWDATE = DateTimeFormat( "%d", Now(5) ); 

if(StaticVarGetText("ALITOKEN"+USERNUM) == "" AND LOGDATE1 == NOWDATE  AND ACSTOK1 != "")
{
_TRACE("Setting AliceBlue Session "+USERNUM);
StaticVarSetText("ALIUSERID"+USERNUM,USERID1);
StaticVarSetText("ALITOKEN"+USERNUM,ACSTOK1);
ShellExecute(LIMITSSCRIPT1," \""+StaticVarGetText("ALIUSERID"+USERNUM)+"\" \""+StaticVarGetText("ALITOKEN"+USERNUM)+"\" ","",EnCMD);
}

 //DataFeed
if(GUIEVEID == 2 AND GUIEVENT == 1 )
{
ShellExecute(FEEDSCRIPT,"","",1);
}

//LIMITS
if(GUIEVEID == 3 AND GUIEVENT == 1  AND StaticVarGetText("ALITOKEN"+USERNUM) != "" )
{
/*UserID = StaticVarGetText("ALIUSERID" + USERNUM);
Token  = StaticVarGetText("ALITOKEN" + USERNUM);
_TRACE("TOKEN LENGTH = " + NumToStr(StrLen(Token), 1.0));
_TRACE("TOKEN START = " + StrLeft(Token, 30));
_TRACE("TOKEN END = " + StrRight(Token, 30));*/
ShellExecute(LIMITSSCRIPT1," \""+StaticVarGetText("ALIUSERID"+USERNUM)+"\" \""+StaticVarGetText("ALITOKEN"+USERNUM)+"\" ","",EnCMD);
}


fh = fopen( LIMITSFILE1, "r" );

LIMSTATS1 = LIMCASH1 = LIMERROR1 = "";
if( fh )
 {
     while( ! feof( fh ) )
     {         
         line = fgets( fh );
         key = StrExtract( line, 0 );               
         if ( key == "status" )
         { 
         LIMSTATS1 = StrTrim(StrExtract(line,1),"",2);    
         }
         if ( key == "message" )
         { 
         LIMERROR1 = StrTrim(StrExtract(line,1),"",2);
            
         }if ( key == "openingCashLimit" )
         { 
         LIMCASH1 = StrTrim(StrExtract(line,1),"",2);     
         }
     }
     fclose( fh );
 } 
 
 

 //HistData
if(GUIEVEID == 4 AND GUIEVENT == 1 )
{
ShellExecute(HISTSCRIPT," \""+EXPDATEHDF+"\" \""+EXPDATEHDT+"\" \""+ENIMPORTDATAHD+"\" \""+ENDELETEDATAHD+"\" \""+FILETODOHD+"\" \""+TIMEFRAMEHD+"\" \""+PARAHD+"\"","",1);
}


 //GFX  
GfxSetBkMode(1);
GfxSelectFont("Verdhana", 14, 700, False ); 
GfxSetTextColor(colorBrightGreen);
GfxTextOut("AliceBlue",PX*2,PY*1.5);
 

StatusLogin1 = WriteIf(LOGDATE1 != NOWDATE, "Please Login",  WriteIf(ACSTOK1 == "", "Token not found", USERID1+" "+"Login Succesfull"));

ColorLogin1 = IIf(StatusLogin1 == USERID1+" "+"Login Succesfull",colorBrightGreen,colorRed);
GfxSetTextColor(ColorLogin1);

StatusLimit1 = WriteIf(LIMSTATS1 != "Ok",LIMERROR1, WriteIf(LIMSTATS1 == "Ok" AND LOGDATE1 == NOWDATE,"Cash "+ LIMCASH1,"Get Limits"));

GfxTextOut(StatusLogin1+"          "+StatusLimit1,PX*30+PX*HX,PY*4.5+PY*HY);

 





