RequestTimedRefresh(1,False);

//Chart Code Start ----------------------------
_N(Title = StrFormat("{{NAME}} - {{INTERVAL}} {{DATE}} O %g, H %g, L %g, C %g  {{VALUES}}", O, H, L, C  ));
SetChartOptions(0,chartShowArrows|chartShowDates);
SetBarFillColor( IIf( C > O, ColorRGB( 0, 75, 0 ), IIf( C <= O, ColorRGB( 75, 0, 0 ), colorLightGrey ) ) );
Plot( C, "", IIf( C > O, ColorRGB( 0, 255, 0 ), IIf( C <= O, ColorRGB( 255, 0, 0 ), colorLightGrey ) ), 64, Null, Null, 0, 0, 1 );
//Chart Code End ---------------------------------------

//Strategy Code Start---------------------------------
Buy = Sell = Short = Cover = 0;
//Strategy Code End -----------------------------------------

//Defaults
CZ = LastValue(C);
TN = TimeNum();
TZ = LastValue(TN);

//Parameters
_SECTION_BEGIN("Dhan Futures Order");
LOTS = Param("No. of Lots",1,1,50);
EnAlgo = ParamToggle("Enable Algo","No|Yes",1);
EnOrdNo = ParamToggle("Need Order No","No|Yes",1);
OUTPATH = ParamStr("Path to Save Response","R:\\");
STGTAG = ParamStr("Strategy Tag","FUTURES");

HX = Param("Button Horizontal Position",0,0,164);
HY = Param("Button Vertical Position",0,0,89);
_SECTION_END();

//Prefix for Static Variable
SName = STGTAG+Name()+Interval();

if (StrFind( Name(), "SENSEX" ))
{
EXCSEG = "BSE_FNO";
}
else if(StrFind( Name(), "BANKNIFTY" ))
{
EXCSEG = "NSE_FNO";
}
else if (StrFind( Name(), "NIFTY" ))
{
EXCSEG = "NSE_FNO";
}
else if (StrFind( Name(), "SILVER" ))
{
EXCSEG = "MCX_COMM";
}
else if (StrFind( Name(), "GOLD" ))
{
EXCSEG = "MCX_COMM";
}
else
{
EXCSEG = "NSE_FNO";
}

EXPDATE = DateTimeToStr(GetFnData("DividendPayDate")); 
SYMTOK = GetFnData("WebID");
//Button-------------------------------------------

PX = 10;//round(Status("pxwidth")/164);
PY = 10;//round(Status("pxheight")/89);

Reset = 0;

GuiButton( "Buy", 1,  PX*1+PX*HX, PY*2+PY*HY, PY*6, PY*3, notifyClicked );
GuiButton( "Sell", 2,  PX*8+PX*HX, PY*2+PY*HY, PY*6, PY*3, notifyClicked );

GuiButton( "Short",3,  PX*1+PX*HX, PY*6+PY*HY, PY*6, PY*3, notifyClicked );
GuiButton( "Cover", 4,  PX*8+PX*HX, PY*6+PY*HY, PY*6, PY*3, notifyClicked );

GuiButton( "Reset", 5, PX*15+PX*HX, PY*2+PY*HY, PY*6, PY*3, notifyClicked );

GuiSetColors( 1, 2, 2, colorBlack, colorLime,colorGreen,-1,colorGreen);
GuiSetColors( 3, 4, 2, colorYellow, colorOrange,colorRed,-1,colorRed);
GuiSetColors( 5, 6, 2, colorBlack, colorYellow, colorGold,-1,colorGold); 

function HandleEvents() 
{ 
    for ( n = 0;id = GuiGetEvent( n, 0 );n++ )
    { 
        code = GuiGetEvent( n, 1 ); 
         switch ( id ) 
        { 
             case 1:                      
             Buy = 1;             
             break;
              
             case 2:                     
             Sell = 1;             
             break; 
                         
             case 3:                        
             Short= 1;             
             break;
             
             case 4:                       
             Cover = 1;             
             break;
             
             case 5:                      
             Reset = 1;            
             break;   
             
             case 6:                        
             Button6 = 1;            
             break;                           
        } 
    } 
} 
HandleEvents();

//Button Code End--------------------------------------


//API------------------------------------------------------------------------------------------------

DHNURL = "https://api.dhan.co/v2/orders";

function DhanOrder(TRANTYPE,TSYM,QTY,PRC,TRGPRC,PRCTYP,PRD,EXCH,UID,TOKEN,OUT)
{
ShellExecute("Curl.exe","-X POST \""+DHNURL+"\" -H \"Content-Type: application/json\" -H \"access-token: "+TOKEN+"\" -d \"{ \\\"dhanClientId\\\":\\\""+UID+"\\\", \\\"correlationId\\\":\\\"123abc678\\\", \\\"transactionType\\\":\\\""+TRANTYPE+"\\\", \\\"exchangeSegment\\\":\\\""+EXCH+"\\\", \\\"productType\\\":\\\""+PRD+"\\\", \\\"orderType\\\":\\\""+PRCTYP+"\\\", \\\"validity\\\":\\\"DAY\\\", \\\"securityId\\\":\\\""+TSYM+"\\\", \\\"quantity\\\":\\\""+QTY+"\\\", \\\"disclosedQuantity\\\":\\\"\\\", \\\"price\\\":\\\""+PRC+"\\\", \\\"triggerPrice\\\":\\\""+TRGPRC+"\\\" }\"  "+OUT+"","",0);
return;
}

/*
//Telegram Alert Function
function Telegram(Key,ID,Message)
{
ih = InternetOpenURL("https://api.telegram.org/bot"+Key+"/sendMessage?chat_id="+ID+"&text="+Message); 
if(ih) InternetClose( ih );
return ;
}

//Telegram
BOTKEY = ParamStr("Telegram Bot Key","");
CHANNELID = ParamStr("Channel ID","");

*/


DHNUID1 = StaticVarGetText("DHNUSERID"+"1");//"1" - User Number
DHNTOK1 = StaticVarGetText("DHNTOKEN"+"1");//"1" - User Number
DHNOUTRESP1 = WriteIf(EnOrdNo,"-o "+OUTPATH+"\\"+Name()+"1"+".txt","");//"1" - User Number
DHNSESSIONOK1 = DHNUID1 != "" AND DHNTOK1 != "" ;
SYMTOKOK = StrToNum(SYMTOK) > 0;
EXPDATEOK = EXPDATE != "";
SYMINFOOK = SYMTOKOK AND EXPDATEOK;

QTY = ""+LOTS * RoundLotSize;

//Messages
BuyMessage = "Buy "+Name()+" "+SYMTOK+" Qty "+QTY+" @ "+CZ;
SellMessage = "Sell "+Name()+" "+SYMTOK+" Qty "+QTY+" @ "+CZ;
ShortMessage = "Short "+Name()+" "+SYMTOK+" Qty "+QTY+" @ "+CZ;
CoverMessage = "Cover "+Name()+" "+SYMTOK+" Qty "+QTY+" @ "+CZ;

//Order Place Function Parameters: Buy/Sell, Token, Quantity, Price,Trigger Price, PriceType LIMIT / MARKET / STOP_LOSS / STOP_LOSS_MARKET, Product CNC / INTRADAY / MARGIN / BO / CO / MTF , Exchange_Segment NSE_EQ / NSE_FNO / BSE_EQ / BSE_FNO / MCX_COMM , User ID, Access Token,Respone enable and path


//Place Order----------------------------------------------------

//Buy
if (LastValue(Buy) AND Nz(StaticVarGet(SName+"INUPTRADE")) == 0 AND Nz(StaticVarGet(SName+"UPExitTime")) != TZ)
{
if(EnAlgo  AND DHNSESSIONOK1 AND SYMINFOOK) DhanOrder("BUY",SYMTOK,QTY,"","","MARKET","MARGIN",EXCSEG,DHNUID1,DHNTOK1,DHNOUTRESP1);
_TRACE("BUY"+SYMTOK+QTY+""+""+"MARKET"+"MARGIN"+EXCSEG+DHNUID1+DHNTOK1+DHNOUTRESP1);
StaticVarSet(SName+"INUPTRADE",1);
StaticVarSet(SName+"UPENTRY",CZ);
_TRACE(BuyMessage);
//PopupWindow(BuyMessage, Name(),5,800,50);
//Telegram(BOTKEY,CHANNELID,BuyMessage); 
}

UPENTRY = StaticVarGet(SName+"UPENTRY");
UPPNL = CZ - UPENTRY;

//Sell
if (LastValue(Sell)  AND StaticVarGet(SName+"INUPTRADE"))
{
if(EnAlgo  AND DHNSESSIONOK1 AND SYMINFOOK) DhanOrder("SELL",SYMTOK,QTY,"","","MARKET","MARGIN",EXCSEG,DHNUID1,DHNTOK1,DHNOUTRESP1);
StaticVarSet(SName+"INUPTRADE",0);
StaticVarSet(SName+"UNENTRY",0);
StaticVarSet(SName+"UPExitTime",TZ);
_TRACE(SellMessage);
//PopupWindow(SellMessage, Name(),5,800,50);
//Telegram(BOTKEY,CHANNELID,SellMessage); 
}

//Short
if (LastValue(Short) AND Nz(StaticVarGet(SName+"INDNTRADE")) == 0  AND Nz(StaticVarGet(SName+"DNExitTime")) != TZ)
{
if(EnAlgo  AND DHNSESSIONOK1 AND SYMINFOOK) DhanOrder("SELL",SYMTOK,QTY,"","","MARKET","MARGIN",EXCSEG,DHNUID1,DHNTOK1,DHNOUTRESP1);
StaticVarSet(SName+"INDNTRADE",1);
StaticVarSet(SName+"DNENTRY",CZ);
_TRACE(ShortMessage);
//PopupWindow(ShortMessage, Name(),10,300,50);
//Telegram(BOTKEY,CHANNELID,ShortMessage); 
}

DNENTRY = StaticVarGet(SName+"DNENTRY");
DNPNL = CZ - DNENTRY;

//Cover
if (LastValue(Cover)  AND StaticVarGet(SName+"INDNTRADE"))
{
if(EnAlgo  AND DHNSESSIONOK1 AND SYMINFOOK) DhanOrder("BUY",SYMTOK,QTY,"","","MARKET","MARGIN",EXCSEG,DHNUID1,DHNTOK1,DHNOUTRESP1);
StaticVarSet(SName+"INDNTRADE",0);
StaticVarSet(SName+"DNENTRY",0);
StaticVarSet(SName+"DNExitTime",TZ);
_TRACE(CoverMessage);
//PopupWindow(CoverMessage, Name(),10,700,50);
//Telegram(BOTKEY,CHANNELID,CoverMessage);     
}

//Reset
if(Reset)
{
StaticVarSet(SName+"INUPTRADE",0);
StaticVarSet(SName+"INDNTRADE",0);
StaticVarSet(SName+"UPENTRY",0);
StaticVarSet(SName+"DNENTRY",0);
StaticVarSet(SName+"UPExitTime", 0);
StaticVarSet(SName+"DNExitTime", 0);
}


//Dashboard-----------------------------------------------------
BoardColor = IIf(StaticVarGet(SName+"INUPTRADE"),colorPaleGreen, IIf(StaticVarGet(SName+"INDNTRADE"),colorPink, IIf(EnAlgo  AND DHNSESSIONOK1 AND SYMINFOOK, colorYellow, colorWhite)));
GfxSetBkColor(BoardColor);
GfxSelectSolidBrush(BoardColor);
GfxRoundRect(PX*1, PY*10, PX*25, PY*18,PX,PX);

If(StaticVarGet(SName+"INUPTRADE"))
{
GfxTextOut(Name()+" Qty "+QTY, PX*2, PY*11);
GfxTextOut("Entry "+UPENTRY+" PNL "+UPPNL,PX*2, PY*13);

}
else If(StaticVarGet(SName+"INDNTRADE"))
{
GfxTextOut(Name()+" Qty "+QTY, PX*2, PY*11);
GfxTextOut("Entry "+DNENTRY+" PNL "+DNPNL,PX*2, PY*13);
}
else
{
GfxTextOut(Name()+" Qty "+QTY, PX*2, PY*11);
}

if(EnAlgo AND !DHNSESSIONOK1)GfxTextOut("Not Logged In", PX*2, PY*11); 
GfxTextOut("Token "+WriteIf(SYMTOKOK,SYMTOK,"Import Token"), PX*2, PY*13);
GfxTextOut("Expiry "+WriteIF(EXPDATEOK,EXPDATE,"Import Expiry Date"), PX*2, PY*15);



